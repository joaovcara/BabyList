# =============================================================================
# BabyList — variáveis de ambiente
# Copie para .env: cp .env.example .env
# =============================================================================

# Segredo do JWT (obrigatório em produção — use valor longo e aleatório)
JWT_SECRET=change-me-to-a-strong-secret

# Porta no HOST onde o frontend (Nginx do container) fica acessível.
# Em servidor com proxy reverso, use bind em 127.0.0.1 (veja docker-compose.yml).
APP_PORT=8081

# Base path do frontend no build (deve coincidir com o subcaminho no proxy, se houver)
VITE_BASE_PATH=/BabyList/
